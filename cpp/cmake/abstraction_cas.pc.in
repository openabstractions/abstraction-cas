prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: abstraction_cas
Description: Atomic compare-and-set over files using kernel locks
URL: https://github.com/openabstractions/abstraction-cas
Version: @PROJECT_VERSION@
Libs: -L${libdir} -labstraction_cas
Cflags: -I${includedir}
